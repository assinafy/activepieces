  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assinafy/activepieces.git"
  },
  "keywords": [
    "activepieces",
    "assinafy",
    "e-signature",
    "assinatura-eletronica"
  ],
  "scripts": {
    "prepare": "sh scripts/fetch-framework.sh",
