    "test:live": "ASSINAFY_LIVE=1 vitest run test/live.test.ts",
    "translations": "vitest run test/piece.test.ts --update",
    "licenses": "node scripts/bundled-licenses.mjs"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "@vitest/coverage-v8": "3.2.6",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "ipaddr.js": "2.3.0",
    "nanoid": "3.3.18",
    "typescript": "5.5.4",
    "vitest": "3.2.6",
    "zod": "4.3.6"
  }
}
