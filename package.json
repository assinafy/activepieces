{
  "name": "@assinafy/piece-assinafy",
  "version": "0.1.1",
  "private": true,
  "description": "Activepieces piece for Assinafy electronic signatures.",
  "license": "MIT",
  "author": "Assinafy",
  "homepage": "https://github.com/assinafy/activepieces#readme",
  "bugs": {
