{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022", "dom"],
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@activepieces/pieces-framework": ["./.activepieces/packages/pieces/framework/src/index.ts"],
      "@activepieces/pieces-common": ["./.activepieces/packages/pieces/common/src/index.ts"],
      "@activepieces/core-piece-types": ["./.activepieces/packages/core/piece-types/src/index.ts"],
      "@activepieces/core-utils": ["./.activepieces/packages/core/utils/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
